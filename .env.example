# Site Base URL for canonical tags, Open Graph, and sitemap generation
# [REPLACE] Set your verified live domain URL (e.g., https://mayankaggarwal.com or https://klikwise.com)
VITE_SITE_URL=https://example.com

# Google Search Console Verification Meta Tag (e.g. google-site-verification=abc123xyz)
VITE_GOOGLE_SITE_VERIFICATION=your_google_search_console_token_here

# Bing Webmaster Tools Verification Meta Tag (msvalidate.01 content value)
VITE_BING_SITE_VERIFICATION=your_bing_webmaster_token_here

# Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

