# Site Base URL for canonical tags, Open Graph, and sitemap generation
VITE_SITE_URL=https://mayank-aggarwal.vercel.app

# Google Search Console Verification Meta Tag
VITE_GOOGLE_SITE_VERIFICATION=your_google_search_console_token_here

# Bing Webmaster Tools Verification Meta Tag
VITE_BING_SITE_VERIFICATION=your_bing_webmaster_token_here

# Semrush Site Audit Verification Meta Tag
VITE_SEMRUSH_SITE_VERIFICATION=your_semrush_token_here

# Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel AI Gateway Key
VERCEL_AI_GATEWAY_KEY=your_vercel_ai_gateway_key_here
